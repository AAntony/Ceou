{
  "cli": {
    "version": ">= 21.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "env": { "EXPO_PUBLIC_BILLING_MODE": "test", "EXPO_PUBLIC_REVENUECAT_TEST_STORE": "true" },
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "development"
    },
    "preview": {
      "environment": "preview",
      "env": { "EXPO_PUBLIC_BILLING_MODE": "test", "EXPO_PUBLIC_REVENUECAT_TEST_STORE": "false" },
      "autoIncrement": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "channel": "preview"
    },
    "production": {
      "environment": "production",
      "env": { "EXPO_PUBLIC_BILLING_MODE": "live", "EXPO_PUBLIC_REVENUECAT_TEST_STORE": "false" },
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
